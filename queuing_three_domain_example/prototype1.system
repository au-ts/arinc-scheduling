<!-- Channels -->

<!-- Timer-Scheduler -->
<channel>
    <end pd="timer" id="1" pp="false" notify="true"/>
    <end pd="scheduler" id="1" pp="true" notify="false" />
</channel>

<!-- Timer-sPD -->
<channel>
    <end pd="timer" id="2" pp="false" notify="true"/>
    <end pd="p1_spd" id="1" pp="true" notify="false"/>
</channel>
<channel>
    <end pd="timer" id="3" pp="false" notify="true"/>
    <end pd="p2_spd" id="1" pp="true" notify="false"/>
</channel>
<channel>
    <end pd="timer" id="4" pp="false" notify="true"/>
    <end pd="p3_spd" id="1" pp="true" notify="false"/>
</channel>

<!-- Scheduler-sPD -->
<channel>
    <end pd="scheduler" id="2" pp="false" notify="true" />
    <end pd="p1_spd" id="2" pp="false" notify="false" />
</channel>
<channel>
    <end pd="scheduler" id="3" pp="false" notify="true" />
    <end pd="p2_spd" id="2" pp="false" notify="false" />
</channel>
<channel>
    <end pd="scheduler" id="4" pp="false" notify="true" />
    <end pd="p3_spd" id="2" pp="false" notify="false" />
</channel>

<!-- sPD-ePD -->
<channel> 
    <end pd="p1_spd" id="3" pp="false" notify="true" />
    <end pd="p1_epd" id="1" pp="false" notify="false"/>
</channel>

<channel> 
    <end pd="p2_spd" id="3" pp="false" notify="true" />
    <end pd="p2_epd" id="1" pp="false" notify="false"/>
</channel>

<channel> 
    <end pd="p3_spd" id="3" pp="false" notify="true" />
    <end pd="p3_epd" id="1" pp="false" notify="false"/>
</channel>

<!-- sPD-UPD -->
<channel> 
    <end pd="p1_spd" id="4" pp="false" notify="true" />
    <end pd="p1_upd" id="1" pp="false" notify="true"/>
</channel>

<channel> 
    <end pd="p2_spd" id="4" pp="false" notify="true" />
    <end pd="p2_upd" id="1" pp="false" notify="true"/>
</channel>

<channel> 
    <end pd="p3_spd" id="4" pp="false" notify="true" />
    <end pd="p3_upd" id="1" pp="false" notify="true"/>
</channel>

<!-- ePD-uPD -->
<channel>
    <end pd="p1_epd" id="2" pp="false" notify="true" />
    <end pd="p1_upd" id="2" pp="false" notify="true" />
</channel>

<channel>
    <end pd="p2_epd" id="2" pp="false" notify="true" />
    <end pd="p2_upd" id="2" pp="false" notify="true" />
</channel>

<channel>
    <end pd="p3_epd" id="2" pp="false" notify="true" />
    <end pd="p3_upd" id="2" pp="false" notify="true" />
</channel>

<!-- sPD-uPD Init -->
<channel>
    <end pd="p1_spd" id="5" pp="false" notify="false" />
    <end pd="p1_upd" id="3" pp="false" notify="true"/>
</channel>

<channel>
    <end pd="p2_spd" id="5" pp="false" notify="false" />
    <end pd="p2_upd" id="3" pp="false" notify="true"/>
</channel>

<channel>
    <end pd="p3_spd" id="5" pp="false" notify="false" />
    <end pd="p3_upd" id="3" pp="false" notify="true"/>
</channel>

<!-- sPD-uPD Finish Init -->
<channel>
    <end pd="p1_spd" id="6" pp="false" notify="false" />
    <end pd="p1_upd" id="4" pp="false" notify="true"/>
</channel>

<channel>
    <end pd="p2_spd" id="6" pp="false" notify="false" />
    <end pd="p2_upd" id="4" pp="false" notify="true"/>
</channel>

<channel>
    <end pd="p3_spd" id="6" pp="false" notify="false" />
    <end pd="p3_upd" id="4" pp="false" notify="true"/>
</channel>

</system>