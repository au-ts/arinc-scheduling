    <program_image path="p1_ppd.elf" />
    <map mr="p1_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="status" />

    <map mr="p1_to_p2_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="P2_PORT" />
