<?xml version="1.0" encoding="UTF-8"?>


<system>

<!-- <memory_region name="timer_registers" size="0x10_000" phys_addr="0xffd0f000" /> -->

<protection_domain name="timer" priority="254">
    <program_image path="timer_driver.elf" />
    <!-- <map mr="timer" vaddr="0x2_000_000" perms="rw" cached="false" setvar_vaddr="timer_regs" /> -->
    <irq irq="30" id="0" />
    <!-- <map mr="timer_registers" vaddr="0x2_000_000" perms="rw" cached="false" setvar_vaddr="gpt_regs" /> -->
    <!-- <irq irq="42" id="0" trigger="edge" /> timer interrupt for timer A -->
</protection_domain>

  

<protection_domain name="scheduler" priority="253">
    <program_image path="scheduler.elf" />
    <map mr="p1_state" vaddr="0x1_000_000" perms="rw" setvar_vaddr="p1_state" />
    <map mr="p1_attr" vaddr="0x1_001_000" perms="rw" setvar_vaddr="p1_attr" />
    <map mr="p2_state" vaddr="0x1_002_000" perms="rw" setvar_vaddr="p2_state" />
    <map mr="p2_attr" vaddr="0x1_003_000" perms="rw" setvar_vaddr="p2_attr" />
    <map mr="p3_state" vaddr="0x1_004_000" perms="rw" setvar_vaddr="p3_state" />
    <map mr="p3_attr" vaddr="0x1_005_000" perms="rw" setvar_vaddr="p3_attr" />

    <tcb pd_name="p1_upd" id="1" />
    <tcb pd_name="p2_upd" id="2" />
    <tcb pd_name="p3_upd" id="3" />

</protection_domain>

<memory_region name="uart" size="0x1_000" phys_addr="0xff803000" />

<!-- Partition states -->

<memory_region name="p1_state" size="0x1_000" />
<memory_region name="p1_attr" size="0x1_000" />

<memory_region name="p2_state" size="0x1_000" />
<memory_region name="p2_attr" size="0x1_000" />

<memory_region name="p3_state" size="0x1_000" />
<memory_region name="p3_attr" size="0x1_000" />

<!-- Application states -->

<memory_region name="p1_pco_stack" size="0x1_000" />
<memory_region name="p1_aco_stack" size="0x1_000" />

<memory_region name="p2_pco_stack" size="0x1_000" />
<memory_region name="p2_aco_stack" size="0x1_000" />

<memory_region name="p3_pco_stack" size="0x1_000" />
<memory_region name="p3_aco_stack" size="0x1_000" />

<memory_region name="p1_aco_ctxt" size="0x1_000" />
<memory_region name="p2_aco_ctxt" size="0x1_000" />
<memory_region name="p3_aco_ctxt" size="0x1_000" />
<memory_region name="p1_pco_ctxt" size="0x1_000" />
<memory_region name="p2_pco_ctxt" size="0x1_000" />
<memory_region name="p3_pco_ctxt" size="0x1_000" />

<memory_region name="p1_upd_state" size="0x1_000" />
<memory_region name="p2_upd_state" size="0x1_000" />
<memory_region name="p3_upd_state" size="0x1_000" />

<!-- Ports -->
<memory_region name="p1_to_p2_port" size="0x1_000" />

<memory_region name="p1_broadcast_port" size="0x1_000" />

<memory_region name="p2_to_p3_port" size="0x1_000" />

<memory_region name="p2_p1_recv_port" size="0x1_000" />

<memory_region name="p3_p2_recv_port" size="0x1_000" />

<memory_region name="p2_p1_broadcast_recv_port" size="0x1_000" />

<memory_region name="p3_p1_broadcast_recv_port" size="0x1_000" />

<!-- Partition PDs -->

<!-- NEW P1 -->
<protection_domain name="p1_epd" passive="true" priority="250">
    <program_image path="p1_epd.elf" /> 
    <map mr="p1_state" vaddr="0x10_000_000" perms="rw" setvar_vaddr="partition_state" />
    <map mr="p1_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="upd_status" />
    <map mr="p1_pco_ctxt" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_ctxt" />

    <tcb pd_name="p1_upd" id="1" />
</protection_domain>

<protection_domain name="p1_spd" passive="true" priority="200" budget="1000" period="6000">
        <program_image path="p1_spd.elf" />
        <map mr="p1_state" vaddr="0x10_000_000" perms="rw" setvar_vaddr="partition_state" />
        <map mr="p1_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="upd_status" />
        <map mr="p1_pco_ctxt" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_ctxt" />
        <map mr="p1_aco_ctxt" vaddr="0x10_003_000" perms="rw" setvar_vaddr="aco_ctxt" />

        <map mr="uart" vaddr="0x10_004_000" perms="rw" cached="false" setvar_vaddr="uart_base" />

        <!-- <map mr="p1_to_p2_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="SEND_P2_PORT" /> -->
        <!-- <map mr="p1_broadcast_port" vaddr="0x10_003_000" perms="rw" setvar_vaddr="SEND_ALL_PORT" /> -->
        <tcb pd_name="p1_upd" id="1" />
</protection_domain>

<protection_domain name="p1_upd" passive="true" priority="102" budget="1000" period="6000">
        <program_image path="p1_upd.elf" />
        <map mr="p1_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="status" />
        <map mr="p1_pco_stack" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_stack" />
        <map mr="p1_aco_stack" vaddr="0x10_003_000" perms="rw" setvar_vaddr="aco_stack" />

        <!-- <map mr="p1_to_p2_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="P2_PORT" /> -->
        <!-- <map mr="p1_broadcast_port" vaddr="0x10_003_000" perms="rw" setvar_vaddr="BROADCAST_PORT" /> -->
</protection_domain>
<!-- End New P1 -->

<!-- NEW P2 -->
<protection_domain name="p2_epd" passive="true" priority="250">
    <program_image path="p2_epd.elf" /> 
    <map mr="p2_state" vaddr="0x10_000_000" perms="rw" setvar_vaddr="partition_state" />
    <map mr="p2_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="upd_status" />
    <map mr="p2_pco_ctxt" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_ctxt" /> 

    <tcb pd_name="p2_upd" id="1" />
</protection_domain>

<protection_domain name="p2_spd" passive="true" priority="200" budget="1000" period="6000">
        <program_image path="p2_spd.elf" />
        <map mr="p2_state" vaddr="0x10_000_000" perms="rw" setvar_vaddr="partition_state" />
        <map mr="p2_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="upd_status" />
        <map mr="p2_pco_ctxt" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_ctxt" />
        <map mr="p2_aco_ctxt" vaddr="0x10_003_000" perms="rw" setvar_vaddr="aco_ctxt" />

        <map mr="uart" vaddr="0x10_004_000" perms="rw" cached="false" setvar_vaddr="uart_base" />

        <!-- <map mr="p1_to_p2_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="SEND_P2_PORT" /> -->
        <!-- <map mr="p1_broadcast_port" vaddr="0x10_003_000" perms="rw" setvar_vaddr="SEND_ALL_PORT" /> -->
        <tcb pd_name="p2_upd" id="2" />
</protection_domain>

<protection_domain name="p2_upd" passive="true" priority="101" budget="1000" period="6000">
        <program_image path="p2_upd.elf" />
        <map mr="p2_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="status" />
        <map mr="p2_pco_stack" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_stack" />
        <map mr="p2_aco_stack" vaddr="0x10_003_000" perms="rw" setvar_vaddr="aco_stack" />
        <!-- <map mr="p1_to_p2_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="P2_PORT" /> -->
        <!-- <map mr="p1_broadcast_port" vaddr="0x10_003_000" perms="rw" setvar_vaddr="BROADCAST_PORT" /> -->
        <map mr="uart" vaddr="0x10_004_000" perms="rw" cached="false" setvar_vaddr="uart_base" />

    </protection_domain>
<!-- End New P2 -->

<!-- New P3 -->
<protection_domain name="p3_epd" passive="true" priority="250">
    <program_image path="p3_epd.elf" /> 
    <map mr="p3_state" vaddr="0x10_000_000" perms="rw" setvar_vaddr="partition_state" />
    <map mr="p3_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="upd_status" />
    <map mr="p3_pco_ctxt" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_ctxt" /> 

    <tcb pd_name="p3_upd" id="1" />
</protection_domain>

<protection_domain name="p3_spd" passive="true" priority="200" budget="1000" period="6000">
    <program_image path="p3_spd.elf" />
    <map mr="p3_state" vaddr="0x10_000_000" perms="rw" setvar_vaddr="partition_state" />
    <map mr="p3_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="upd_status" />
    <map mr="p3_pco_ctxt" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_ctxt" />
    <map mr="p3_aco_ctxt" vaddr="0x10_003_000" perms="rw" setvar_vaddr="aco_ctxt" />

    <tcb pd_name="p3_upd" id="1" />
<!-- 
    <map mr="p2_to_p3_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="P2_SEND_PORT" />
    <map mr="p1_broadcast_port" vaddr="0x10_003_000" perms="r" setvar_vaddr="P1_BROADCAST_PORT" />

    <map mr="p3_p2_recv_port" vaddr="0x10_004_000" perms="rw" setvar_vaddr="P2_RECV" />
    <map mr="p3_p1_broadcast_recv_port" vaddr="0x10_005_000" perms="rw" setvar_vaddr="P1_BROADCAST_RECV" /> -->
</protection_domain>

<protection_domain name="p3_upd" passive="true" priority="100" budget="1000" period="6000">
    <program_image path="p3_upd.elf" />
    <map mr="p3_upd_state" vaddr="0x10_001_000" perms="rw" setvar_vaddr="status" />
    <map mr="p3_pco_stack" vaddr="0x10_002_000" perms="rw" setvar_vaddr="pco_stack" />
    <map mr="p3_aco_stack" vaddr="0x10_003_000" perms="rw" setvar_vaddr="aco_stack" />

    <!-- <map mr="p3_p2_recv_port" vaddr="0x10_002_000" perms="rw" setvar_vaddr="P2_RECV" />
    <map mr="p3_p1_broadcast_recv_port" vaddr="0x10_003_000" perms="r" setvar_vaddr="P1_BROADCAST_RECV" /> -->
</protection_domain>
<!-- End New P3 -->

